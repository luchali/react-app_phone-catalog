{
  "extends": "@mate-academy/students-ts-config",
  "include": [
    "src",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "models/*": ["src/models/*"],
      "src/*": ["src/*"],
      "modules/*": ["src/modules/*"],
      "public/*": ["public/*"],
      "services/*": ["src/services/*"],
      "shared/*": ["src/modules/shared/*"]
    },
    "sourceMap": false,
    "types": ["node", "cypress"]
  }
}
